node_modules
dist
recordings
playwright-report
test-results
.DS_Store
*.local
.env
.env.*
!.env.example
!.env.docker-test

# Raw Harbor job output at the repo root: per-trial agent sessions and logs,
# often large. Anchored so it does not also swallow harbor/jobs/, which holds
# the committed job configurations. The normalized exports under
# results/harbor/ are what gets published.
/jobs/

# Installable CLI output and local package artifacts.
/packages/cli/dist/
*.tgz
/.scratch/heval-cli.png
/.scratch/report-smoke-*/
/.scratch/harbor-runner-*/
/.scratch/runner-smoke-*/

# Webfonts the poster exporter inlines into its PNGs, fetched on first run.
harbor/report/.fontcache/

# HyperFrames verification frames and rendered media are reproducible from the
# normalized job JSON and composition source. Keep binaries out of Git.
results/harbor/social/**/snapshots/
results/harbor/social/**/*.mp4
results/harbor/social/**/*.mov
results/harbor/social/**/*.webm
results/harbor/social/**/*.gif

# Generated motion compositions and render assets.
results/harbor/social/**/index.html
results/harbor/social/**/assets/

# Local chart previews, downloaded reference material, and export artifacts.
/results/reference/
/results/harbor/posters/
/results/harbor/threads/
/.scratch/
.vercel

# Persistent application state and private deployment configuration.
/data/
/deploy/ssh/
/deploy/*.env
/.tools/
.env*
