node_modules
dist
recordings
playwright-report
test-results
.DS_Store
*.local
.env
.env.*
!.env.example
!.env.docker-test

# Raw Harbor job output at the repo root: per-trial agent sessions and logs,
# often large. Anchored so it does not also swallow harbor/jobs/, which holds
# the committed job configurations. The normalized exports under
# results/harbor/ are what gets published.
/jobs/

# Installable CLI output and local package artifacts.
/packages/cli/dist/
*.tgz
/.scratch/heval-cli.png
/.scratch/report-smoke-*/
/.scratch/harbor-runner-*/
/.scratch/runner-smoke-*/

# Webfonts the poster exporter inlines into its PNGs, fetched on first run.
harbor/report/.fontcache/

# HyperFrames verification frames and rendered media are reproducible from the
# normalized job JSON and composition source. Keep binaries out of Git.
results/harbor/social/**/snapshots/
results/harbor/social/**/*.mp4
results/harbor/social/**/*.mov
results/harbor/social/**/*.webm
results/harbor/social/**/*.gif

# The built composition itself. `bun run social:build` regenerates it from the
# job JSON, it is ~1.5MB apiece, and it inlines ~280KB of base64 FH Oscar Pro -
# a face licensed to Merge, which must not ship from a public repo. The gsap
# bundle beside it is copied straight out of node_modules by the same script.
results/harbor/social/**/index.html
results/harbor/social/**/assets/

# Local chart previews and reference downloads; canonical thread ZIPs are tracked.
/results/reference/
/results/harbor/posters/merge-gateway-five-models/
/results/harbor/posters/merge-gateway-five-models-social/
# Poster HTML is an editable, fully reproducible rendering that inlines fonts.
# Keep the much smaller PNG examples, but do not commit generated HTML copies.
/results/harbor/posters/**/*.html
/results/harbor/threads/*/images/
/results/harbor/threads/*/*.png
/results/harbor/threads/*/studio-export.zip
/results/harbor/threads/*/all-presets.json
/results/harbor/threads/recreated/
/.scratch/merge-comparison-run.yaml*
.vercel

# Persistent application state and private deployment configuration.
/data/
/deploy/ssh/
/deploy/*.env

# Isolated study tool downloads and machine-local evidence.
/.tools/
/harbor/deepseek-study/local/
.env*
