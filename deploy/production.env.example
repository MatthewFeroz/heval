HEVAL_DOMAIN=heval.example.com
HEVAL_PUBLIC_ORIGIN=https://heval.example.com
WORKOS_CLIENT_ID=client_replace_me
WORKOS_API_HOSTNAME=api.workos.com
HEVAL_ALLOWED_USER_IDS=user_replace_me
HEVAL_ENABLE_RUNNER=1
HEVAL_ENABLE_EXPORTS=1
HEVAL_GATEWAY_API_KEY=
HEVAL_GATEWAY_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
HEVAL_ALLOWED_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b,nvidia/nemotron-super-3-120b
HEVAL_WORKER_IMAGE=heval-worker:local
HEVAL_MAX_CONCURRENT_RUNS=2
HEVAL_MAX_RUNS_PER_USER=1
HEVAL_MAX_DAILY_RUNS_PER_USER=6
HEVAL_RUN_TIMEOUT_MS=300000
DOCKER_HOST=ssh://heval-worker@10.0.0.2

# Required: 32 random bytes encoded as 64 hexadecimal characters. Keep stable
# across restarts and store separately from database backups. Never use VITE_.
HEVAL_CONNECTION_ENCRYPTION_KEY=
