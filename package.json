{
  "name": "openeval",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "packageManager": "bun@1.4.2",
  "type": "module",
  "scripts": {
    "cli:build": "bun packages/cli/scripts/build.ts",
    "cli:test": "bun test packages/cli/src",
    "cli:smoke": "bun packages/cli/scripts/smoke.ts",
    "cli:setup:smoke": "bun packages/cli/scripts/setup-smoke.ts",
    "cli:smoke:published": "bun packages/cli/scripts/smoke.ts --registry",
    "cli:pack": "bun run cli:build && npm pack ./packages/cli --pack-destination .scratch",
    "dev": "vite --host 0.0.0.0",
    "studio:local": "bun scripts/local-studio.ts",
    "build": "bun run social:build && tsc -b && vite build",
    "start": "bun run build && bun server/index.ts",
    "serve": "bun server/index.ts",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:auth": "bun scripts/auth-session-smoke.ts",
    "test:deployments": "bun scripts/deployment-smoke.ts",
    "test:unit": "bun test src/project src/charts src/onboarding src/runs/database.test.ts src/reports/libraryItems.test.ts src/reports/taskComparison.test.ts src/observability.test.ts src/runners/modelReference.test.ts scripts/refresh-merge-public-catalog.test.ts harbor/report",
    "test:backend": "vitest run",
    "test:reports": "bun run test:backend",
    "test:reports:smoke": "bun scripts/report-smoke.ts",
    "test:runners:smoke": "bun scripts/runner-smoke.ts",
    "preview": "vite preview --host 0.0.0.0",
    "report": "bun harbor/report/build-report.ts",
    "studies:refresh": "bun scripts/refresh-study-stats.ts",
    "poster": "bun harbor/report/build-poster.ts",
    "social:build": "bun harbor/social/build-completion.ts",
    "social:check": "HYPERFRAMES_NO_TELEMETRY=1 hyperframes check results/harbor/social/demo-evaluation --at 0,2.8,5.7,7.9",
    "status": "bash harbor/status.sh",
    "test:server": "bun test server --path-ignore-patterns 'server/hosted-exports/**'",
    "test:proxy": "bun test harbor/proxy/vendor-proxy.test.ts",
    "test:docker": "bun run worker:build && bun test --env-file=.env.docker-test server/docker.integration.test.ts",
    "worker:build": "docker build -f server/worker/Dockerfile -t heval-worker:local .",
    "thread": "bun harbor/report/build-thread.ts",
    "experiment": "bun harbor/experiment.ts",
    "build:public": "HEVAL_PUBLIC_BUILD=1 VITE_HEVAL_PUBLIC_DEMO=1 bun run build",
    "build:showcase": "VITE_HEVAL_STATIC_SITE=1 bun run build",
    "publish:result": "bun scripts/publish-result.ts",
    "exports:snapshot": "bun scripts/export-snapshot.ts",
    "test:exports": "vitest run --config vitest.hosted.config.ts",
    "test:exports:ui": "bun scripts/hosted-export-ui-smoke.ts",
    "test:exports:renderer": "bun scripts/export-renderer-smoke.ts",
    "models:refresh": "bun scripts/refresh-merge-public-catalog.ts",
    "test:runs:ui": "bun scripts/run-viewer-ui-smoke.ts",
    "test:evaluations:ui": "bun scripts/evaluation-ui-smoke.ts",
    "test:onboarding:ui": "bun scripts/first-smoke-ui-smoke.ts",
    "demo:first-smoke": "bun scripts/first-smoke-ui-smoke.ts --capture .scratch/first-smoke",
    "test:evaluations:e2e": "bun run cli:build && bun scripts/connected-evaluation-ci.ts",
    "runs:build": "bun scripts/build-run-database.ts",
    "managed:coordinator": "bun server/managed/main.ts",
    "managed:worker:build": "bun run cli:build && docker build --platform=linux/amd64 -f deploy/managed/Dockerfile.worker -t heval-managed-worker:local .",
    "managed:test:worker": "bun scripts/managed-worker-smoke.ts"
  },
  "dependencies": {
    "@clerk/react": "^6.17.5",
    "@daytona/sdk": "0.226.1",
    "@hyperframes/player": "0.8.27",
    "@sentry/react": "^11.9.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "2.8.0",
    "@vercel/sandbox": "3.3.0",
    "@vitejs/plugin-react": "latest",
    "@xterm/xterm": "^6.0.0",
    "convex": "^1.45.0",
    "gsap": "3.14.2",
    "jose": "^6.2.10",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vega": "^6.4.0",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.3",
    "vite": "latest"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "latest",
    "@playwright/test": "^1.55.1",
    "@types/bun": "^1.4.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "convex-test": "^0.0.58",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "hyperframes": "0.8.27",
    "typescript": "~5.9.3",
    "typescript-eslint": "latest",
    "vitest": "^5.0.1"
  }
}
