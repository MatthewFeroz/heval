# WorkOS AuthKit. The client ID is public and must be available to both builds.
VITE_WORKOS_CLIENT_ID=client_replace_me
WORKOS_CLIENT_ID=client_replace_me
# Without a custom domain, AuthKit persists its staging refresh token in the
# browser. A custom Authentication API domain enables HttpOnly-cookie sessions.
# Set these to a hostname only, on the same site as the app.
VITE_WORKOS_API_HOSTNAME=
WORKOS_API_HOSTNAME=api.workos.com

# Persistent report workspace (Convex). `bunx convex dev` configures .env.local.
VITE_CONVEX_URL=
# Production deploy key belongs in Vercel's Production environment only.
# Never prefix a deploy key with VITE_ or put it in browser code.
CONVEX_DEPLOY_KEY=

# Real harness execution is disabled unless explicitly enabled.
HEVAL_ENABLE_RUNNER=0
HEVAL_ENABLE_EXPORTS=0
HEVAL_GATEWAY_API_KEY=
# Keep this pinned for reproducible comparisons. Do not use default_routing.
HEVAL_GATEWAY_MODEL=anthropic/claude-sonnet-4-5-20250929
HEVAL_WORKER_IMAGE=heval-worker:local
HEVAL_MAX_CONCURRENT_RUNS=2
HEVAL_MAX_RUNS_PER_USER=1
HEVAL_RUN_TIMEOUT_MS=300000
HEVAL_GRADE_TIMEOUT_MS=30000
HEVAL_MAX_OUTPUT_BYTES=8388608
# Local access only by default. Set explicitly for a trusted network deployment.
HOST=127.0.0.1
PORT=4173

# Optional model picker. Only these server-approved models may be launched.
# Merge IDs differ from NVIDIA's direct API IDs. Refresh the catalog first.
HEVAL_ALLOWED_MODELS=anthropic/claude-sonnet-4-5-20250929
HEVAL_MAX_DAILY_RUNS_PER_USER=20
# Persistent volume path; defaults to local data/ for signups and recordings/ for runs.
HEVAL_DATA_DIR=
# Optional: nvidia uses the direct NVIDIA API with Pi; otherwise Merge Gateway.
HEVAL_PROVIDER=merge-gateway
HEVAL_NVIDIA_API_KEY=
# Optional JSON object mapping model IDs to vendor names, used by Pi.
HEVAL_VENDOR_PINS_JSON={}
# For hosted deployment use deploy/production.env.example and docs/deployment.md.

# Browser BYOK: encrypted per-user keys. Local development generates a private
# data/connection-encryption.key when this is empty. Required for hosted mode.
HEVAL_CONNECTION_ENCRYPTION_KEY=
# Local Docker must reach the Bun API on this URL. On Docker Desktop use HOST=0.0.0.0
# with a trusted local network, or expose a private worker-reachable endpoint.
HEVAL_INFERENCE_PROXY_URL=http://host.docker.internal:4173/api/inference
# CLI demo only: this computer's IP/hostname reachable from a remote Docker worker.
# Uses a temporary port; leave empty when running through local Docker Desktop.
HEVAL_DEMO_PROXY_HOST=
