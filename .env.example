# WorkOS AuthKit. The client ID is public and must be available to both builds.
VITE_WORKOS_CLIENT_ID=client_replace_me
WORKOS_CLIENT_ID=client_replace_me
# Only set these when using a WorkOS custom Authentication API domain.
VITE_WORKOS_API_HOSTNAME=
WORKOS_API_HOSTNAME=api.workos.com

# Real harness execution is disabled unless explicitly enabled.
HEVAL_ENABLE_RUNNER=0
HEVAL_ENABLE_EXPORTS=0
HEVAL_GATEWAY_API_KEY=
# Keep this pinned for reproducible comparisons. Do not use default_routing.
HEVAL_GATEWAY_MODEL=anthropic/claude-sonnet-4-5-20250929
HEVAL_WORKER_IMAGE=heval-worker:local
HEVAL_MAX_CONCURRENT_RUNS=2
HEVAL_MAX_RUNS_PER_USER=1
HEVAL_RUN_TIMEOUT_MS=300000
HEVAL_GRADE_TIMEOUT_MS=30000
HEVAL_MAX_OUTPUT_BYTES=8388608
# Local access only by default. Set explicitly for a trusted network deployment.
HOST=127.0.0.1
PORT=4173
